
<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <h2 class="mb-4">My Chats</h2>

    <% if(conversations.length === 0) { %>

        <div class="alert alert-light text-center">
            You don't have any conversations yet.
        </div>

    <% } else { %>

        <div class="list-group">

            <% conversations.forEach(conversation => { %>

                <% const otherUser = conversation.participants.find(user => !user._id.equals(currUser._id)); %>

                <a href="/chats/<%= conversation._id %>"
                   class="list-group-item list-group-item-action p-3">

                    <h5 class="mb-1">
                        <%= otherUser ? otherUser.username : "User" %>
                    </h5>

                    <p class="mb-0 text-muted">
                        <%= conversation.listing ? conversation.listing.title : "Listing unavailable" %>
                    </p>

                </a>

            <% }) %>

        </div>

    <% } %>

</div>
